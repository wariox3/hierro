# Variables de entorno de hierro (servicios de Semántica Digital).
#
# En local: copia este archivo a `.env` y completa los valores.
# En producción: van en /opt/hierro/.env (la API) y /opt/hierro/.env.admin
# (migraciones). Git ignora los dos: nunca van en el repositorio.

# --- PostgreSQL ---------------------------------------------------------------
# URL que usa la API. En producción, con el rol api_noticias (solo SELECT).
# Siempre con el driver asyncpg. En DigitalOcean usa el puerto de conexión DIRECTA
# (25060), no el del pool de PgBouncer.
DATABASE_URL=postgresql+asyncpg://api_noticias:CONTRASEÑA@HOST:25060/BASE

# URL del rol propietario (owner_noticias): migraciones de Alembic y
# scripts/crear_api_key.py. Si no se define, se usa DATABASE_URL.
# En producción va SOLO en .env.admin, nunca en el entorno de la API.
# ADMIN_DATABASE_URL=postgresql+asyncpg://owner_noticias:CONTRASEÑA@HOST:25060/BASE

# TLS hacia PostgreSQL: disable | require | verify-full. No pongas sslmode en la URL.
#   require      cifra sin verificar el certificado (equivale a sslmode=require).
#   verify-full  cifra y verifica con el CA de DATABASE_SSL_ROOT_CERT.
DATABASE_SSL=require
# DATABASE_SSL_ROOT_CERT=/opt/hierro/certs/ca-certificate.crt

# Pool de conexiones por worker de Uvicorn (total = workers x (pool + overflow)).
DATABASE_POOL_SIZE=5
DATABASE_MAX_OVERFLOW=5
DATABASE_POOL_TIMEOUT=10
# Segundos tras los cuales se recicla una conexión.
DATABASE_POOL_RECYCLE=1800
# Tiempo máximo por consulta, en milisegundos.
DATABASE_STATEMENT_TIMEOUT_MS=5000

# --- Redis --------------------------------------------------------------------
# Toda la conexión va en la URL. En local: redis://localhost:6379/0.
# En producción, Redis administrado con TLS (rediss://) y el CA en la propia URL:
#   rediss://default:CONTRASEÑA@HOST:25061/0?ssl_ca_certs=/opt/hierro/certs/redis-ca.crt
REDIS_URL=redis://localhost:6379/0
# Obligatorio. El Redis administrado es compartido: todas las claves del servicio
# empiezan por este prefijo, distinto en cada entorno (hierro:dev, hierro:produccion).
REDIS_KEY_PREFIX=hierro:dev
# Timeout de conexión y de cada operación, en segundos. Si Redis falla, la API
# sigue funcionando contra PostgreSQL (sin caché ni rate limit) y lo registra en el log.
REDIS_TIMEOUT=0.5

# --- Caché --------------------------------------------------------------------
# Segundos que una respuesta queda en Redis. Las inserciones por SQL tardan como
# máximo esto en verse en la API.
CACHE_TTL=120
# max-age del header Cache-Control que reciben los clientes.
HTTP_CACHE_MAX_AGE=60
# Segundos que se cachea la validación de una API key. Al desactivar una key por SQL,
# puede seguir entrando durante este tiempo.
AUTH_CACHE_TTL=300

# --- Rate limiting (por API key) ---------------------------------------------------
# Máximo de solicitudes por ventana; al excederlo se responde 429.
RATE_LIMIT_REQUESTS=120
RATE_LIMIT_WINDOW=60

# --- HTTP ---------------------------------------------------------------------
# Orígenes permitidos por CORS, separados por comas. Vacío = CORS cerrado.
CORS_ORIGINS=
# Publica /docs y /openapi.json.
DOCS_ENABLED=true
# DEBUG | INFO | WARNING | ERROR
LOG_LEVEL=INFO

# --- Solo tests -------------------------------------------------------------------
# Los tests usan las credenciales de DATABASE_URL sobre la base <nombre>_test, que
# crean si no existe y cuyo esquema BORRAN en cada corrida. La de DATABASE_URL no se toca.
# Base de Redis para tests: se vacía en cada test.
# TEST_REDIS_URL=redis://localhost:6379/15
