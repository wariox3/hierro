# Unidad systemd de hierro (servicios de Semántica Digital).
# Instalar en /etc/systemd/system/hierro.service (ver deploy/APROVISIONAMIENTO.md).

[Unit]
Description=Hierro (servicios REST de Semántica Digital)
After=network-online.target
Wants=network-online.target

[Service]
Type=exec
User=hierro
Group=hierro
WorkingDirectory=/opt/hierro
EnvironmentFile=/opt/hierro/.env
Environment=PYTHONUNBUFFERED=1 PYTHONDONTWRITEBYTECODE=1
ExecStart=/opt/hierro/.venv/bin/uvicorn app.main:app \
    --host 127.0.0.1 --port 8053 \
    --workers 4 \
    --proxy-headers --forwarded-allow-ips=127.0.0.1 \
    --log-config /opt/hierro/deploy/uvicorn-logging.json \
    --no-access-log --no-server-header \
    --timeout-graceful-shutdown 20
Restart=always
RestartSec=3
TimeoutStopSec=30
KillMode=mixed

# Endurecimiento: el usuario no tiene privilegios y el código es de solo lectura.
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
PrivateTmp=true
PrivateDevices=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectKernelLogs=true
ProtectControlGroups=true
ProtectClock=true
ProtectHostname=true
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
RestrictNamespaces=true
RestrictRealtime=true
RestrictSUIDSGID=true
LockPersonality=true
CapabilityBoundingSet=
AmbientCapabilities=
SystemCallArchitectures=native
SystemCallFilter=@system-service
UMask=0077

[Install]
WantedBy=multi-user.target
